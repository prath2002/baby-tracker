# ---------- Required ----------
# Runtime connection (pooled). Use the dedicated NOBYPASSRLS role "babyapp" (see DEPLOY.md).
DATABASE_URL=postgres://babyapp:PASSWORD@HOST/babytracker?sslmode=require
# Direct (non-pooled) connection for migrations/seeding, same role.
MIGRATION_DATABASE_URL=postgres://babyapp:PASSWORD@DIRECT-HOST/babytracker?sslmode=require
# Only for providers that sign with their own root CA (Supabase: Database settings -> SSL -> Download certificate).
# Paste the PEM on one line with \n for line breaks. TLS verification stays on.
DATABASE_CA_CERT=
APP_URL=https://your-domain.example
# 32+ random characters: openssl rand -hex 32
APP_SECRET=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET": openssl rand -hex 32
CRON_SECRET=

# ---------- Sign-in delivery ----------
EMAIL_PROVIDER=resend            # resend | console (development only)
RESEND_API_KEY=
EMAIL_FROM="Baby Health <no-reply@your-domain.example>"
SMS_PROVIDER=none                # none | twilio | console (development only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Private document storage (S3-compatible, India region) ----------
STORAGE_DRIVER=s3

S3_REGION=region
S3_BUCKET=documents
S3_ACCESS_KEY_ID=YOUR_SUPABASE_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_SUPABASE_S3_SECRET_KEY
S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_FORCE_PATH_STYLE=true
# ---------- Malware scanning ----------
SCANNER=http                     # http (scanner/ service) | clamd | dev-allow (development only)
SCANNER_URL=https://baby-health-scanner.fly.dev
SCANNER_TOKEN=

# ---------- Web push (node scripts/generate-vapid.mjs) ----------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@your-domain.example

# ---------- Policy ----------
PRIVACY_NOTICE_VERSION=2026-10-draft-1
GRIEVANCE_CONTACT=grievance@your-domain.example
# Shows UNVERIFIED reference data with banners on staging/preview only. Refused in production.
REFERENCE_PREVIEW_MODE=false

# ---------- Chat assistant (OpenRouter) ----------
# Leave the key empty to hide the chat button. Pick a model that supports tool calling:
# https://openrouter.ai/models?supported_parameters=tools
# Also disable prompt logging/training in your OpenRouter privacy settings (health data).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
